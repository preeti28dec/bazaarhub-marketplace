generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All money values are stored in paise (integer) to avoid float rounding.
// Commission rates are stored in basis points (1000 = 10%).

enum Role {
  ADMIN
  MERCHANT
  CUSTOMER
}

enum MerchantStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum AccessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  REJECTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentMethod {
  COD
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENT
  FLAT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role     @default(CUSTOMER)
  active        Boolean  @default(true)
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())

  sessions  Session[]
  merchant  Merchant?
  cartItems CartItem[]
  wishlist  WishlistItem[]
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  auditLogs AuditLog[]
}

model Session {
  id        String   @id // sha256 of the cookie token, never the raw token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Merchant {
  id            String         @id @default(cuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String
  phone         String
  addressLine   String
  city          String
  state         String
  pincode       String
  gstin         String?
  pan           String?
  description   String?
  logoUrl       String?
  bannerUrl     String?
  businessHours String?
  deliveryDays  Int            @default(4)
  commissionBps Int? // overrides the category commission when set
  status        MerchantStatus @default(PENDING)
  statusReason  String?
  createdAt     DateTime       @default(now())

  products       Product[]
  categoryAccess MerchantCategory[]
  subscriptions  Subscription[]
  orderItems     OrderItem[]
}

model Plan {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String
  price         Int
  durationDays  Int
  productLimit  Int // 0 = unlimited
  maxCategories Int // 0 = all eligible categories
  features      String[]
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id         String             @id @default(cuid())
  merchantId String
  merchant   Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  planId     String
  plan       Plan               @relation(fields: [planId], references: [id])
  status     SubscriptionStatus @default(PENDING_PAYMENT)
  amount     Int
  paymentRef String?
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime           @default(now())

  @@index([merchantId, status])
}

model Category {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  icon             String?
  imageUrl         String?
  commissionBps    Int                @default(1000)
  requiresApproval Boolean            @default(false) // e.g. medicines: needs explicit admin grant even on Premium
  active           Boolean            @default(true)
  sortOrder        Int                @default(0)
  parentId         String?
  parent           Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[]         @relation("CategoryTree")
  products         Product[]
  merchantAccess   MerchantCategory[]
}

model MerchantCategory {
  id         String       @id @default(cuid())
  merchantId String
  merchant   Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id])
  status     AccessStatus @default(PENDING)
  note       String?
  createdAt  DateTime     @default(now())

  @@unique([merchantId, categoryId])
}

model Product {
  id              String        @id @default(cuid())
  merchantId      String
  merchant        Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  name            String
  description     String
  specs           Json?
  price           Int
  mrp             Int
  stock           Int
  images          String[]
  status          ProductStatus @default(PENDING)
  rejectionReason String?
  featured        Boolean       @default(false)
  rating          Float         @default(0)
  ratingCount     Int           @default(0)
  soldCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  cartItems  CartItem[]
  wishlist   WishlistItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([status, categoryId])
  @@index([merchantId])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  description String?
  type        CouponType
  value       Int // percent for PERCENT, paise for FLAT
  minOrder    Int        @default(0)
  maxDiscount Int?
  active      Boolean    @default(true)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
}

model Order {
  id                String        @id @default(cuid())
  number            String        @unique
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  address           Json
  subtotal          Int
  discount          Int           @default(0)
  shippingFee       Int           @default(0)
  total             Int
  couponCode        String?
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  status            OrderStatus
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  createdAt         DateTime      @default(now())
  items             OrderItem[]

  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id              String      @id @default(cuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  merchantId      String
  merchant        Merchant    @relation(fields: [merchantId], references: [id])
  name            String
  image           String?
  price           Int
  quantity        Int
  commissionBps   Int
  commission      Int
  merchantEarning Int
  status          OrderStatus
  updatedAt       DateTime    @updatedAt

  @@index([merchantId, status])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
