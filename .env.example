# Copy to .env and adjust. docker compose reads this file automatically.
POSTGRES_PASSWORD=market_dev_pw
SEED_DEMO=true
ADMIN_EMAIL=admin@shop.test
ADMIN_PASSWORD=Admin@123
# Set true when serving over HTTPS
COOKIE_SECURE=false

# Razorpay (leave empty to run with Cash on Delivery only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Host port for Postgres (container is always 5432)
DB_PORT=5434
